{
  "name": "live-training-portfolio-template",
  "version": "1.0.0",
  "description": "A portfolio template laid out as an ML notebook, opening with a neural network that trains live in the browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:ml": "esbuild tests/ml.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ml.test.mjs --log-level=warning && node node_modules/.cache/ml.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@vercel/analytics": "^1.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "author": "Malay Doshi"
}
